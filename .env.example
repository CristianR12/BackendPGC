# --- Desarrollo local ---
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FIREBASE_CREDENTIALS_PATH=CredencialesFirebase/asistenciaconreconocimiento-firebase-adminsdk.json
# Administradores (aprueban docentes). Correos separados por coma; deben tener el correo verificado.
ADMIN_EMAILS=tu.correo@ucundinamarca.edu.co
# Dominios que pueden registrarse (los administradores quedan exentos)
REGISTRO_DOMINIOS=ucundinamarca.edu.co

# --- Producción (Render) ---
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<lo genera Render>
# CORS_ALLOWED_ORIGINS=https://tu-sitio.netlify.app
# FIREBASE_CREDENTIALS_JSON=<contenido completo del JSON de credenciales, en una línea>
# ADMIN_EMAILS=<correos de los administradores, separados por coma>
# REGISTRO_DOMINIOS=ucundinamarca.edu.co
# (ALLOWED_HOSTS se completa solo con RENDER_EXTERNAL_HOSTNAME)
